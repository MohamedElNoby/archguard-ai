# Copy this file to `.env` and adjust as needed.
# For the hackathon MVP, SQLite is used. Switching to PostgreSQL later only
# requires changing this URL - no application code changes needed.
DATABASE_URL=sqlite:///./archredteam.db

APP_NAME=AI ArchRedTeam - Database & State API
APP_VERSION=1.0.0
API_PREFIX=/api/v1
DEBUG=true
