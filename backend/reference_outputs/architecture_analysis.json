        "risks": [
            {
                "level": "CRITICAL",
                "title": "Cascading Failure via Synchronous Microservice Chaining",
                "description": "User Service, Product Service, Order Service, and Payment Service are connected sequentially in a chain. A failure or latency spike in any upstream service will block and fail the entire transaction process."
            },
            {
                "level": "HIGH",
                "title": "Shared Central Database Anti-Pattern",
                "description": "All microservices share a single PostgreSQL Database instance. This creates tight schema coupling, noisy-neighbor performance bottlenecks, and violates the microservice encapsulation principle."
            },
            {
                "level": "MEDIUM",
                "title": "Single Point of Failure at API Gateway & Authentication Service",
                "description": "All incoming traffic depends strictly on the API Gateway and central Authentication Service without depicted async fallback or queuing mechanisms, creating a critical architectural bottleneck."
            }
        ]
    },
